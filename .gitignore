# Local configuration and sensitive secrets
.env
.env.*
!.env.example
/config/*.local.php
/config/database-demo.sql

# Composer dependencies
/vendor/

# Runtime storage: ignore generated files but keep directory guards/placeholders
/storage/**
!/storage/
!/storage/.htaccess
!/storage/.gitkeep
!/storage/**/
!/storage/**/.htaccess
!/storage/**/.gitkeep

# User-uploaded files (retain only local upload guards)
/public/uploads/**
!/public/uploads/
!/public/uploads/**/
!/public/uploads/**/.htaccess
!/public/uploads/**/.gitkeep

# Temporary files, logs, and local backups
*.log
*.tmp
*.bak
*.old
/backups/
/tmp/

# Local database files
*.sqlite
*.sqlite3
*.db
*.dump

# Operating system and IDE files
.DS_Store
Thumbs.db
.idea/

# Local private keys and certificate bundles
*.key
*-key.pem
*.pem
*.p8
*.p12
*.pfx

# Local SQL dumps and exports; keep the reviewed public seed
*.sql
!/config/database-public.sql

